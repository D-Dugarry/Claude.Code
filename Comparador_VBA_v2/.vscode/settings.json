{
    // Intérprete Python — Python 3.14 con las librerías del proyecto instaladas
    "python.defaultInterpreterPath": "C:\\Users\\FX706\\AppData\\Local\\Programs\\Python\\Python314\\python.exe",

    // Pylance como servidor de lenguaje
    "python.languageServer": "Pylance",

    // Análisis de tipos estricto para detectar errores antes de ejecutar
    "python.analysis.typeCheckingMode": "basic",

    // Autocompletado con todos los módulos instalados
    "python.analysis.autoImportCompletions": true,

    // Formato al guardar
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // Excluir carpetas de compilación del explorador
    "files.exclude": {
        "**/__pycache__": true,
        "**/build": true,
        "**/*.spec": true,
        "**/*.pyc": true
    },

    // Regla visual a 100 caracteres (los módulos VBA son anchos)
    "editor.rulers": [100],

    // Breadcrumbs útil para navegar entre clases y métodos
    "breadcrumbs.enabled": true,

    // Mostrar espacios en blanco para detectar indentación mixta
    "editor.renderWhitespace": "boundary"
}
