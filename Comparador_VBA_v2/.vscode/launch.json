            "args": [
                "F:\\__Dugarry UA\\Dugarry Proyectos\\___Claude.Code\\JyG.Code\\_JyC 2026.Code.xlsm",
                "F:\\__Dugarry UA\\Dugarry Proyectos\\_Jornadas y Congresos\\Programación JyC\\_JyC 2026.xlsm",
