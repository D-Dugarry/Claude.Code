{
    // Intérprete Python — apunta al Python 3.14 donde están las librerías instaladas
    "python.defaultInterpreterPath": "C:/Users/FX706/AppData/Local/Programs/Python/Python314/python.exe",

    // Formateo automático al guardar
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,

    // Codificación UTF-8 para todos los archivos
    "files.encoding": "utf8",

    // Excluir carpetas de artefactos del explorador
    "files.exclude": {
        "**/__pycache__": true,
        "**/build": true,
        "**/*.pyc": true,
        "**/*.spec": true
    },

    // Autocompletado de Python
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "basic",

    // Terminal integrada: usar PowerShell
    "terminal.integrated.defaultProfile.windows": "PowerShell",

    // Variable de entorno para que print() funcione bien en terminal
    "terminal.integrated.env.windows": {
        "PYTHONIOENCODING": "utf-8"
    }
}
